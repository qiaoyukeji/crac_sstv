# 复制为 android/keystore.properties 并填好，CI 或本地就会用这把钥匙签 release 包。
# 不填也能出包 —— 会自动退化为 debug 签名，只是**不能覆盖安装**用另一把钥匙签的版本。
#
# 生成一把自己的钥匙（需要 JDK）：
#   keytool -genkeypair -v -keystore sstv-release.jks -alias sstv \
#           -keyalg RSA -keysize 2048 -validity 10950 \
#           -storepass <你的密码> -keypass <你的密码> \
#           -dname "CN=SSTV Studio, OU=Dev, O=CRAC, L=Hefei, ST=Anhui, C=CN"
#
# ⚠️ sstv-release.jks 与 keystore.properties 都必须在 .gitignore 里，
#    一旦泄露，任何人都能用你的名义发版。

storeFile=keystore/sstv-release.jks
storePassword=changeit
keyAlias=sstv
keyPassword=changeit
